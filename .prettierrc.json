{
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "printWidth": 100,
  "vueIndentScriptAndStyle": true,
  "plugins": ["@trivago/prettier-plugin-sort-imports"],

  "importOrder": [
    "^vue$",
    "^vue-(.*)$",
    "<THIRD_PARTY_MODULES>",
    "^@/(.*)$",
    "^@assets/(.*)$",
    "^@styles/(.*)$",
    "^@components/(.*)$",
    "^@lib/(.*)$",
    "^@utils/(.*)$",
    "^[./]"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true
}
